<Window x:Class="DiskPeek.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:DiskPeek.App" Title="DiskPeek" Width="1380" Height="940" MinWidth="960" MinHeight="700" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="12" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown" Closing="Window_Closing">
  <Grid Margin="24,17,24,12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,19">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Grid Width="31" Height="31" Margin="0,0,11,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Grid.RowSpan="2" Background="{DynamicResource AccentBrush}" CornerRadius="4,0,0,4" Margin="0,0,3,0"/><Border Grid.Column="1" Background="#638BD5" CornerRadius="0,4,0,0" Margin="0,0,0,3"/><Border Grid.Column="1" Grid.Row="1" Background="#9374C4" CornerRadius="0,0,4,0"/></Grid>
        <TextBlock Text="DiskPeek" FontWeight="SemiBold" FontSize="23" VerticalAlignment="Center"/>
        <Border Background="{DynamicResource RaisedBrush}" CornerRadius="4" Margin="13,1,0,0" Padding="7,3" VerticalAlignment="Center"><TextBlock Text="OPEN SOURCE" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/></Border>
        <TextBlock Text="Find what fills your disk." Foreground="{DynamicResource MutedBrush}" Margin="17,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Theme" Foreground="{DynamicResource MutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/><ComboBox x:Name="ThemePicker" Width="94" MinHeight="28" SelectionChanged="Theme_Changed" AutomationProperties.Name="Color theme"><ComboBoxItem Content="System"/><ComboBoxItem Content="Dark"/><ComboBoxItem Content="Light"/></ComboBox><Button x:Name="UpdatesButton" Content="Updates" Style="{StaticResource QuietButton}" Margin="9,0,0,0" Click="Updates_Click"/><Button x:Name="RecycleButton" Content="Move to Recycle Bin" IsEnabled="False" ToolTipService.ShowOnDisabled="True" Style="{StaticResource QuietButton}" Margin="9,0,0,0" Click="RecycleSelected_Click"/><Button Content="About" Style="{StaticResource QuietButton}" Margin="9,0,0,0" Click="About_Click"/></StackPanel>
    </Grid>

    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,13" Margin="0,0,0,13">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="SCAN TARGET" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,13,0"/>
        <ComboBox Grid.Column="1" x:Name="TargetBox" IsEditable="True" IsTextSearchEnabled="False" ToolTip="Choose a drive or enter a folder or network path" AutomationProperties.Name="Drive or folder to scan"/>
        <Button Grid.Column="2" x:Name="BrowseButton" Content="Browse…" Margin="9,0,0,0" Click="Browse_Click"/>
        <Button Grid.Column="3" x:Name="ScanButton" Content="Scan" Width="90" Style="{StaticResource PrimaryButton}" Margin="9,0,0,0" Click="Scan_Click" ToolTip="Scan the selected target (F5)"/>
        <Button Grid.Column="4" x:Name="StopButton" Content="Stop" Margin="9,0,0,0" IsEnabled="False" Click="Stop_Click" ToolTip="Stop scanning and retain partial results (Escape)"/>
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="1,0,1,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"><CheckBox x:Name="FastCheck" Content="Fast NTFS scan" IsChecked="True" ToolTip="Enabled by default for supported local NTFS drive roots. Selecting Scan starts a read-only worker with an administrator prompt. Folders and other targets automatically use the directory engine."/><TextBlock Text="NTFS drive roots · requests administrator access" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="12,1,0,0" VerticalAlignment="Center"/></StackPanel>
      <TextBlock Grid.Column="1" Text="AGPL-3.0-or-later · Local analysis" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
    </Grid>

    <UniformGrid Grid.Row="3" Columns="4" Margin="0,0,0,16">
      <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock x:Name="SizeLabel" Text="ALLOCATED FILE DATA" FontSize="10" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold"/><TextBlock x:Name="SizeValue" Text="—" FontSize="27" FontWeight="SemiBold" Margin="0,3,0,1"/><TextBlock x:Name="SizeNote" Text="Choose a drive or folder to begin" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="FILES &amp; FOLDERS" FontSize="10" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold"/><TextBlock x:Name="FilesValue" Text="—" FontSize="27" FontWeight="SemiBold" Margin="0,3,0,1"/><TextBlock x:Name="FilesNote" Text="Metadata scan; file contents stay untouched" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="VOLUME FREE SPACE" FontSize="10" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold"/><TextBlock x:Name="FreeValue" Text="—" FontSize="27" FontWeight="SemiBold" Margin="0,3,0,1"/><TextBlock x:Name="FreeNote" Text="Volume totals include filesystem overhead" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="SCAN TIME" FontSize="10" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold"/><TextBlock x:Name="TimeValue" Text="—" FontSize="27" FontWeight="SemiBold" Margin="0,3,0,1"/><TextBlock x:Name="EngineNote" Text="Ready when you are" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/></StackPanel></Border>
    </UniformGrid>

    <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="590"/><ColumnDefinition Width="12"/><ColumnDefinition Width="276" MinWidth="235" MaxWidth="360"/></Grid.ColumnDefinitions>
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1.15*" MinHeight="150"/><RowDefinition Height="9"/><RowDefinition Height="*" MinHeight="135"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <DockPanel LastChildFill="True"><Button DockPanel.Dock="Left" x:Name="UpButton" Content="↑" Style="{StaticResource QuietButton}" IsEnabled="False" Click="Up_Click" ToolTip="Zoom out to parent folder (Alt+Up)" AutomationProperties.Name="Parent folder"/><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="Breadcrumbs" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="EXPLORER" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="5,0"/></StackPanel></ScrollViewer></DockPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><RadioButton x:Name="AllocatedRadio" Content="Allocated" GroupName="Metric" IsChecked="True" Checked="Metric_Changed" Margin="12,0,12,0"/><RadioButton x:Name="LogicalRadio" Content="Logical" GroupName="Metric" Checked="Metric_Changed" ToolTip="Logical file lengths; hard-link paths may repeat logical bytes"/></StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="4,0,10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TabControl x:Name="ViewTabs" SelectionChanged="View_Changed" Margin="0,0,8,0"><TabItem Header="Folder tree"/><TabItem Header="Largest files" ToolTip="The 1,000 largest matching files within the selected folder"/></TabControl><Grid Grid.Column="1" Margin="4,5,0,5"><TextBox x:Name="SearchBox" MinHeight="30" Padding="9,4,26,4" TextChanged="Search_Changed" ToolTip="Filter names. Use * and ? wildcards. Ctrl+F focuses search." AutomationProperties.Name="Filter file names"/><TextBlock x:Name="SearchHint" Text="Search names or *.ext" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11"/><Button Content="×" HorizontalAlignment="Right" Style="{StaticResource QuietButton}" Padding="6,0" Width="24" MinHeight="26" Click="ClearSearch_Click" ToolTip="Clear search" AutomationProperties.Name="Clear search"/></Grid></Grid>
            <DataGrid Grid.Row="1" x:Name="FileGrid" SelectionChanged="File_SelectionChanged" MouseDoubleClick="File_DoubleClick" Sorting="File_Sorting" AutomationProperties.Name="Scanned folders and files">
              <DataGrid.ContextMenu><ContextMenu><MenuItem Header="Zoom into folder" Click="ZoomSelected_Click"/><MenuItem Header="Show in Explorer" Click="Reveal_Click"/><MenuItem Header="Copy path" Click="Copy_Click"/><Separator/><MenuItem x:Name="RecycleContextItem" Header="Move to Recycle Bin" InputGestureText="Delete" IsEnabled="False" ToolTipService.ShowOnDisabled="True" Click="RecycleSelected_Click"/></ContextMenu></DataGrid.ContextMenu>
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Name" SortMemberPath="Name" Width="*" MinWidth="220"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="{Binding Indent}" ToolTip="{Binding Details}"><Button Content="{Binding ExpandGlyph}" Tag="{Binding Index}" Style="{StaticResource QuietButton}" Padding="0" Width="18" MinHeight="20" Click="Expand_Click" Focusable="False" IsEnabled="{Binding IsDirectory}" AutomationProperties.Name="Expand or collapse folder"/><TextBlock Text="{Binding KindGlyph}" Foreground="{Binding KindBrush}" Margin="2,0,6,0" VerticalAlignment="Center"/><TextBlock Text="{Binding Name}" TextDecorations="{Binding NameDecorations}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="Allocated" Binding="{Binding Allocated}" SortMemberPath="Allocated" Width="113"/>
                <DataGridTextColumn Header="Logical" Binding="{Binding Logical}" SortMemberPath="Logical" Width="113"/>
                <DataGridTextColumn Header="Share" Binding="{Binding Share}" SortMemberPath="Share" Width="72"/>
                <DataGridTextColumn Header="Files" Binding="{Binding Files}" SortMemberPath="Files" Width="82"/><DataGridTextColumn Header="Since scan" Binding="{Binding ChangeStatus}" CanUserSort="False" Width="125"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource DeletionBrush}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Grid.Row="1" x:Name="EmptyHint" Text="Scan a drive or folder to explore its contents.&#x0a;&#x0a;A direct metadata scan finds large files without reading their contents." TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="30" MaxWidth="430" IsHitTestVisible="False"/>
            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="11,5"><TextBlock x:Name="RowCount" Text="No scan loaded" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></Border>
          </Grid>
        </Border>
        <GridSplitter Grid.Row="2" Height="9" HorizontalAlignment="Stretch" Background="Transparent"/>
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="13,9"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="SPACE MAP" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="· snapshot, type colors" ToolTip="Search and type filters apply to the file table. The map shows the full selected folder. Hover a file tile to highlight its folder group and matching tree row; double-click any tile in the group to zoom into that folder. Dense or tiny folder contents may be grouped." Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="8,0,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="Red area = deleted/moved bytes" Foreground="{DynamicResource MutedBrush}" FontSize="10"/></Grid><local:TreemapControl Grid.Row="1" x:Name="Treemap" Margin="5,0,5,5"/><TextBlock Grid.Row="2" x:Name="DeletedStatus" Text="Red marks entries deleted or moved since scan; sizes remain a snapshot." Foreground="{DynamicResource DeletionBrush}" FontSize="10" Margin="11,3,11,8" TextTrimming="CharacterEllipsis"/></Grid></Border>
      </Grid>
      <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" Background="Transparent"/>
      <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="15,13,15,10"><TextBlock Text="FILE TYPES" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="TypesSubtitle" Text="The selected folder, by extension" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><ListBox Grid.Row="1" x:Name="TypesList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="Type_Selected" AutomationProperties.Name="File types; select an extension to filter"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="9" Height="27" Background="{Binding Color}" CornerRadius="2" Margin="0,0,10,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Count}" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{Binding Size}" HorizontalAlignment="Right"/><TextBlock Text="{Binding Share}" Foreground="{DynamicResource MutedBrush}" FontSize="10" HorizontalAlignment="Right" Margin="0,3,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,11"><StackPanel><TextBlock Text="SELECTION" Foreground="{DynamicResource MutedBrush}" FontWeight="SemiBold" FontSize="10"/><TextBlock x:Name="SelectedName" Text="No item selected" FontWeight="SemiBold" Margin="0,7,0,4" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SelectedPath" Text="Select a row or a tile to inspect it." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" MaxHeight="46"/><TextBlock x:Name="SelectedChangeStatus" Foreground="{DynamicResource DeletionBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"/><TextBlock x:Name="SelectedSize" Text="" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="-5,7,0,0"><Button x:Name="RevealButton" Content="Show in Explorer" Style="{StaticResource QuietButton}" Click="Reveal_Click" IsEnabled="False" FontSize="11"/><Button x:Name="CopyButton" Content="Copy path" Style="{StaticResource QuietButton}" Click="Copy_Click" IsEnabled="False" FontSize="11"/></StackPanel></StackPanel></Border>
      </Grid>
    </Grid>

    <Grid Grid.Row="5" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border x:Name="StatusDot" Width="7" Height="7" CornerRadius="4" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="1,0,8,0"/><StackPanel Grid.Column="1"><TextBlock x:Name="StatusText" Text="Ready · Choose a target and press Scan" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/><ProgressBar x:Name="ScanProgressBar" Height="2" Margin="0,5,15,0" IsIndeterminate="True" Visibility="Collapsed" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource RaisedBrush}"/></StackPanel><Button Grid.Column="2" x:Name="IssuesButton" Content="Scan details" Style="{StaticResource QuietButton}" Margin="8,0" Visibility="Collapsed" Click="Issues_Click" Foreground="{DynamicResource WarningBrush}"/><Button Grid.Column="3" x:Name="ExportButton" Content="Export CSV" Style="{StaticResource QuietButton}" IsEnabled="False" Click="Export_Click" ToolTip="Export the complete scan, including paths and both size metrics"/></Grid>
  </Grid>
</Window>
